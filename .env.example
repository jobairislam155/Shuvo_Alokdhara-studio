# --- Supabase ---
# Found in Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin registration ---
# A long secret of your choosing (20+ random characters). Required once, on
# /admin/register, to create the admin account; that page then closes itself.
# Server-only — never prefix with NEXT_PUBLIC_.
ADMIN_SETUP_CODE=

# --- Cloudinary ---
# Found in your Cloudinary dashboard home page.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
